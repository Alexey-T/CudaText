{
  "about": "INI lexer by Alexey Torgashin",
  "files": "*.ini;*.dsk;*.inf;*.srv;*.reg;*.cfg;*.url;*.desktop;.editorconfig;*.cuda-lexmap",
  "cmt_line": ";",
  "case_sens": true,
  "consider_spaces": true,
  "rules": {
    "cmt": {
      "regex": "^\\s*[;\\#].*",
      "style": "Comment"
    },
    "cmt2": {
      "regex": "\\s\\#\\s.*",
      "style": "Comment"
    },
    "section": {
      "regex": "^\\[.+?\\]\\x20*",
      "style": "Label"
    },
    "key": {
      "regex": "^.+?(?==)",
      "style": "Id1"
    },
    "eq": {
      "regex": "=",
      "style": "Symbol"
    },
    "const": {
      "regex": "\\b(true|false)\\b",
      "style": "Id2"
    },
    "val": {
      "regex": "\\w+",
      "style": "Id"
    }
  }
}
